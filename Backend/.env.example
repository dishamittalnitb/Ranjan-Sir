# Ranjan Sir backend — environment variables.
# Copy this file to `.env` (in Backend/) or export the vars in your shell.
# Without a key the mentor falls back to deterministic retrieval.

# Required to enable the Gemini-powered mentor (takes wiki + student context).
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash
